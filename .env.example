# Copy to .env and fill in.

# Database — either DATABASE_URL or the individual DB_* variables.
# DATABASE_URL currently points at the legacy MariaDB instance and is kept
# untouched for instant rollback.
DATABASE_URL=mysql://opportunityos:secret@localhost:3306/opportunityos

# PostgreSQL (the migration target). When PG_DATABASE_URL is set, the app's
# data layer (lib/db.js) uses PostgreSQL through a mysql2-compatible shim;
# DATABASE_URL continues to select MariaDB only as a fallback.
# Managed providers (RDS, Supabase, Neon, Render, Railway, etc.) require TLS —
# append ?sslmode=require or the connection is rejected outright. Local/self-
# hosted Postgres with no TLS listener should leave this off.
PG_DATABASE_URL=postgres://opportunityos:secret@localhost:5432/opportunityos
DB_HOST=localhost
DB_PORT=3306
DB_USER=opportunityos
DB_PASSWORD=secret
DB_NAME=opportunityos

# Public URL of the app (used in generated outreach links)
APP_URL=http://localhost:3000

# Reverse proxies in front of the app (used to read the real client IP for rate
# limits). Only the entry your own proxy appends to X-Forwarded-For is trusted.
#   1 (default) = one proxy/load balancer (nginx, Vercel, Render, ...)
#   2           = e.g. CDN + nginx
#   0           = no proxy: headers ignored, all callers share one bucket per route
# Never run `next start` directly on the internet with this at 1.
TRUSTED_PROXY_HOPS=1

# EMAIL (password reset + email verification) — plain SMTP, works with any
# provider (Gmail app password, Brevo, Mailgun, Amazon SES, Zoho...).
# Without SMTP_HOST: in development the email (with its link) is printed to the
# server console; in PRODUCTION nothing is sent and an error is logged, so users
# could not reset a forgotten password — set this before going live.
SMTP_HOST=
SMTP_PORT=587
# 1 for implicit TLS (port 465); leave 0 for STARTTLS on 587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM=OpportunityOS <no-reply@yourdomain.com>
# 1 = self-registered users must verify their email before using the app (they
# can still sign in, see a banner, and resend the link). Existing users are
# treated as verified. Needs working SMTP first, or new users can never verify.
REQUIRE_EMAIL_VERIFICATION=0

# AI ENGINE (required for AI features; the app reports NOT CONFIGURED without it
# and never fabricates AI output)
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=60000

# GOOGLE PLACES DISCOVERY (provider id: "google_places")
# Populates the Google Places provider in the Discover page.
# Sign up for an API key at https://console.cloud.google.com → APIs & Services → Credentials.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_API_URL=https://maps.googleapis.com/maps/api/place/textsearch/json
GOOGLE_PLACES_DETAILS_URL=https://maps.googleapis.com/maps/api/place/details/json
GOOGLE_PLACES_LANGUAGE=en
GOOGLE_PLACES_MAX_RESULTS=10
GOOGLE_PLACES_FETCH_DETAILS=1
GOOGLE_PLACES_MIN_INTERVAL_MS=500

# WEBSITE LOOKUP (lib/services/research/website-finder.js)
# When a discovered business has no website (common with OSM), look one up via
# Google's official Programmable Search Engine before giving up on research.
# A search match is a guess (self-corrected: the next step fetches it for real
# content). Never scrapes search result pages directly — only this sanctioned API.
# Create a key at https://console.cloud.google.com and a search engine (set to
# search the whole web) at https://programmablesearchengine.google.com.
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_CX=

# OPENSTREETMAP DISCOVERY (provider id: "osm_overpass")
# Free alternative to Google Places — no API key needed. Geocodes via Nominatim,
# then queries the public Overpass API. Set OSM_OVERPASS_ENABLED=0 to disable.
OSM_OVERPASS_ENABLED=1
OSM_OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OSM_OVERPASS_MIN_INTERVAL_MS=5000
OSM_OVERPASS_MAX_RESULTS=50
OSM_NOMINATIM_URL=https://nominatim.openstreetmap.org/search
OSM_NOMINATIM_MIN_INTERVAL_MS=1100
OSM_USER_AGENT=OpportunityOS/0.1 (openstreetmap discovery; polite polling of public OSM services)
OSM_CACHE_DIR=/tmp/osm-overpass-cache
OSM_CACHE_TTL_MS=86400000
OSM_TIMEOUT_MS=60000

# BILLING (Stripe) — lets people actually pay for a plan.
# Without STRIPE_SECRET_KEY, /api/billing/checkout and /api/billing/portal
# return a clear "not configured" error and the account page hides upgrade
# buttons entirely — the app degrades gracefully, it never fakes a purchase.
# 1. Create a Product + recurring Price in Stripe for each paid plan, then set
#    that Price id as the plan's "Stripe price ID" in the admin Plans page
#    (/admin/plans) — a plan with no price ID stays un-purchasable.
# 2. Point a Stripe webhook (checkout.session.completed,
#    customer.subscription.deleted) at <APP_URL>/api/billing/webhook and set
#    its signing secret below.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# INGEST WEBHOOK — POST /api/leads/webhook
# Enable token-based lead ingestion. The token is REQUIRED to be bound to
# exactly one account (set OPPORTUNITYOS_INGEST_ACCOUNT_ID); a leaked token
# can only ever write to that account, never to other tenants.
# Clients must send the header: X-Opportunityos-Token: <token>
# (the account is derived from the server env, NOT from any client header).
OPPORTUNITYOS_INGEST_TOKEN=
OPPORTUNITYOS_INGEST_ACCOUNT_ID=
